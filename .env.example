# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env. The default Codex provider reuses the local
# ChatGPT login and does not require any API key:
# cp .env.example .env
# codex login

# Optional cloud LLM providers (only needed when selected in artemis.jsonc)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Codex model-bound screenshot limits (optional)
# Oversized screenshots are resized proportionally and JPEG-compressed.
ARTEMIS_CODEX_IMAGE_MAX_EDGE=1600
ARTEMIS_CODEX_IMAGE_MAX_BYTES=786432
ARTEMIS_CODEX_IMAGE_JPEG_QUALITY=82

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# iOS (optional): Simulator control needs full Xcode, an iOS runtime, Appium,
# and the XCUITest driver. Physical devices additionally need a trusted,
# Developer Mode-enabled device and a valid WebDriverAgent signing profile.
# Only set these for a team/profile you are authorized to use. ARTEMIS never
# creates certificates or registers devices automatically.
# ARTEMIS_IOS_XCODE_ORG_ID=
# ARTEMIS_IOS_XCODE_SIGNING_ID=Apple Development
# ARTEMIS_IOS_WDA_BUNDLE_ID=
# ARTEMIS_IOS_SHOW_XCODE_LOG=false

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash
